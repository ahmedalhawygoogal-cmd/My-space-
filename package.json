{
  "name": "myspace",
  "private": true,
  "version": "1.57.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && CAPACITOR=1 vite build",
    "patch:audio": "node scripts/patch-audio-recorder.mjs",
    "postinstall": "node scripts/patch-audio-recorder.mjs",
    "cap:sync": "npm run build:native && node scripts/patch-audio-recorder.mjs && cap sync android && node scripts/patch-audio-recorder.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-audio-recorder": "^8.3.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@supabase/supabase-js": "^2.119.0",
    "@types/react-grid-layout": "^1.3.6",
    "firebase": "^13.2.0",
    "lucide-react": "^0.544.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
